# ── Globale stier for treningsserveren ──────────────────────────
# Source denne filen i tmux-sesjonen din:
#   source /home/smartsladding/dokumentbestilling-smart-sladding_test/dokumentbestilling-smart-sladding/server.env

# Repo-rot
export SLADD_REPO=/home/smartsladding/dokumentbestilling-smart-sladding_test/dokumentbestilling-smart-sladding

# Data-mapper
export SLADD_UTTREKK=/data2/smartsladding-uttrekk
export SLADD_LABELS=/home/smartsladding/smartsladding-uttrekk-labels
export SLADD_METADATA=/home/smartsladding/smartsladding-uttrekk-metadata
export SLADD_RUNS=/data2/runs
export SLADD_VALIDERING=/data2/validering
export SLADD_LISTER=$SLADD_VALIDERING/lister

# Standardvekter
export SLADD_PRODVEKTER=$SLADD_REPO/app/weights/weights/yolo-yearly-10000-docs.pt

# Cache (alt derivert/reproduserbart, organisert per uttrekk)
# Struktur: $SLADD_CACHE/uttrekk_N/ocr/, $SLADD_CACHE/uttrekk_N/dataset/
export SLADD_CACHE=/data2/cache

# Verktøy-stier (slipper å huske fulle stier)
export SLADD_RUN=$SLADD_REPO/utils/run.py
export SLADD_PRECACHE=$SLADD_REPO/utils/precache.py
export SLADD_TRAIN=$SLADD_REPO/train

# Loggrot for docker-containerne. Under denne lages gunicorn_logs/ og
# ml_logs/ (prod) og gunicorn_logs_test/ og ml_logs_test/ (test).
# deploy.sh sender den videre til compose som LOG_ROOT.
export SLADD_LOGS=/data/docker

# Antall døgn logghistorikk containerne beholder per loggfil.
export SLADD_LOGG_DAGER=30

# Venv
export SLADD_VENV=$SLADD_REPO/venv/bin/activate
