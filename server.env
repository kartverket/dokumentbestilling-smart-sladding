# ── Global paths for the training server ────────────────────────
# activate.sh sources this file. To load it by hand:
#   source /home/smartsladding/dokumentbestilling-smart-sladding_test/dokumentbestilling-smart-sladding/server.env

# Repo root
export SLADD_REPO=/home/smartsladding/dokumentbestilling-smart-sladding_test/dokumentbestilling-smart-sladding

# Data directories
export SLADD_UTTREKK=/data2/smartsladding-uttrekk
export SLADD_LABELS=/home/smartsladding/smartsladding-uttrekk-labels
export SLADD_METADATA=/home/smartsladding/smartsladding-uttrekk-metadata
export SLADD_RUNS=/data2/runs
export SLADD_VALIDATION=/data2/validering
export SLADD_LISTS=$SLADD_VALIDATION/lister

# Model store. One directory per published model, weights named after the
# model, so the name travels with the file wherever it is copied:
#   $SLADD_WEIGHTS/<name>/<name>.pt     the weights
#   $SLADD_WEIGHTS/<name>/modell.json   what it was trained on, and how
#   $SLADD_WEIGHTS/<name>/trening/      results.csv, args.yaml, split_log.txt
# «make -C $SLADD_TRAIN publiser» creates them after a training run. Raw runs
# (checkpoints, last.pt) stay in $SLADD_RUNS — the store holds only models
# that are finished and ready to use.
export SLADD_WEIGHTS=/data2/vekter

# The model ./deploy.sh build embeds when nothing else is given.
# NB: flat in /data2/models, not in the $SLADD_WEIGHTS layout above.
export SLADD_PRODWEIGHTS=/data2/models/yolo-yearly-10000-docs.pt

# Cache (everything derived and reproducible, one directory per uttrekk).
# Layout: $SLADD_CACHE/uttrekk_N/ocr/, $SLADD_CACHE/uttrekk_N/dataset/
export SLADD_CACHE=/data2/cache

# Tool paths (so you do not have to remember the full ones)
export SLADD_RUN=$SLADD_REPO/utils/run.py
export SLADD_PRECACHE=$SLADD_REPO/utils/precache.py
export SLADD_TRAIN=$SLADD_REPO/train

# Log root on the host for the docker containers. gunicorn_logs/ and ml_logs/
# (prod) and gunicorn_logs_test/ and ml_logs_test/ (test) are created under it.
# deploy.sh passes it on to compose as LOG_ROOT.
export SLADD_LOGS=/data/docker

# Days of log history the containers keep per log file. deploy.sh passes it
# on to compose as LOG_BACKUP_DAYS.
export SLADD_LOG_DAYS=30

# Venv
export SLADD_VENV=$SLADD_REPO/venv/bin/activate
