@startuml
title Smart sladding – pipeline for deteksjon av fødselsnummer

start
:PDF inn (bytes);
:Render alle sider til bilder (300 DPI);

partition "Orientering (per side)" {
  :Finn rotasjon;
  if (Konfidens >= 0.7?) then (ja)
    :Roter bildet (90/180/270);
  else (nei)
    :Ikke roter – stol ikke på gjetningen;
  endif
}

:PaddleOCR på alle sider (batch à 8)\ngir ord-tokens med posisjonsbokser;

partition "Deteksjon (per side)" {
  fork
    :**Paddle-sporet**;
    :Grupper tokens til linjer;
    :Bygg linjetekst + sifferkart\nnormaliser OCR-feil: o/O→0, s/S→5, l/I→1, b/B→6;
    repeat :Glidende vindu: 11 siffer;
      if (Luker OK?\nmaks 3 luker, kun mellomrom . - , _\nog hver luke maks 2 tegn) then (ja)
        if (FNR-form?\ndag 01–31 (d-nr: 41–71), mnd 01–12) then (ja)
          if (Mod11-kontroll?\nbegge kontrollsiffer stemmer) then (ja)
            :TREFF – lag sladdeboks\nover de 5 siste sifrene;
            note right
              hopper 11 siffer frem,
              ellers glir vinduet
              ett siffer videre
            end note
          else (nei)
          endif
        else (nei)
        endif
      else (nei)
      endif
    repeat while (Flere siffer på linja?) is (ja) not (nei)
  fork again
    :**YOLO-sporet**;
    :YOLO predict\nconf >= 0.12, imgsz 1280;
  end fork

  :Slå sammen boksene;
  while (Flere YOLO-bokser?) is (ja)
    if (Dekker en Paddle-boks > 50 %?) then (ja)
      :Merk Paddle-boksen som "begge"\n+ legg på YOLO-conf;
    else (nei)
      if (Vertikal boks?\nhøyde > 1.3 × bredde) then (ja)
        if (conf >= 0.90?) then (ja)
          :Godta som "yolo_vertikal";
        else (nei)
          :Forkast;
        endif
      elseif (Paddle leste tekst i boksen?\ntoken-overlapp > 30 %) then (ja)
        if (Snill sjekk:\nminst 1 siffer OG maks 1 bokstav?) then (ja)
          :Godta som "yolo";
        else (nei)
          :Forkast\n2+ bokstaver = ikke FNR, uansett conf;
        endif
      else (nei – ingen tekst i boksen)
        if (conf >= 0.40?) then (ja)
          :Godta som "yolo";
        else (nei)
          :Forkast;
        endif
      endif
    endif
  endwhile (nei)
  note right
    "Snill sjekk" teller kun tokens
    som inneholder minst ett siffer –
    rene tekstord i boksen ignoreres
  end note
}

:Roter bokser tilbake til original orientering;
:Bygg JSON-respons:\nsider, bokser, kilde (paddle/yolo/begge), conf;
stop
@enduml
