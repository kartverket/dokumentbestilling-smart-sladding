@startuml
title Smart sladding - detection pipeline for fødselsnummer

start
:PDF in (bytes);
:Render all pages to images (300 DPI);

partition "Orientation (per page)" {
  :Find rotation;
  if (Confidence >= 0.7?) then (yes)
    :Rotate the image (90/180/270);
  else (no)
    :Do not rotate - do not trust the guess;
  endif
}

:PaddleOCR over all pages (batches of 8)\ngives word tokens with position boxes;

partition "Detection (per page)" {
  fork
    :**Paddle track**;
    :Group tokens into lines;
    :Build line text + digit map\nnormalise OCR errors: o/O->0, s/S->5, l/I->1, b/B->6;
    repeat :Sliding window: 11 digits;
      if (Gaps OK?\nat most 3 gaps, only space . - , _\nand each gap at most 2 chars) then (yes)
        if (FNR shape?\nday 01-31 (d-nummer: 41-71), month 01-12) then (yes)
          if (Mod11 check?\nboth check digits match) then (yes)
            :HIT - build sladd box\nover the last 5 digits;
            note right
              jumps 11 digits ahead,
              otherwise the window
              slides on by one digit
            end note
          else (no)
          endif
        else (no)
        endif
      else (no)
      endif
    repeat while (More digits on the line?) is (yes) not (no)
  fork again
    :**YOLO track**;
    if (Elektronisk tinglyst?) then (yes)
      :Skip YOLO\nPaddle boxes only;
    else (no)
      :YOLO predict\nconf >= 0.12, imgsz 1280;
    endif
  end fork

  :Merge the boxes;
  while (More YOLO boxes?) is (yes)
    if (Covers a Paddle box > 50 %?) then (yes)
      :Mark the Paddle box "begge"\n+ attach the YOLO conf;
    else (no)
      if (Vertical box?\nheight > 1.3 x width) then (yes)
        if (conf >= 0.90?) then (yes)
          :Accept as "yolo_vertikal";
        else (no)
          :Discard;
        endif
      elseif (Did Paddle read text in the box?\ntoken overlap > 30 %) then (yes)
        if (Lenient check:\nat least 1 digit AND at most 1 letter?) then (yes)
          :Accept as "yolo";
        else (no)
          :Discard\n2+ letters = not an FNR, whatever the conf;
        endif
      else (no - no text in the box)
        if (conf >= 0.40?) then (yes)
          :Accept as "yolo";
        else (no)
          :Discard;
        endif
      endif
    endif
  endwhile (no)
  note right
    The lenient check counts only tokens
    that contain at least one digit -
    plain words in the box are ignored
  end note

  partition "Postfilters (kilde is now final)" {
    :"yolo": discard on a decimal separator\nor line evidence in a confident read;
    :"paddle": discard windows stitched\nacross an oversized gap;
    if (rettsstiftelse profile?) then (koordfam / SE_SEK)
      :Apply the profile rules\n(see config.py);
    else (none)
    endif
    :Dimension filters - too small, too thin,\nwrong ratio; high YOLO conf exempts;
  }
}

:Rotate the boxes back to the original orientation;
:Convert pixels to PDF points;
:Build the JSON response: a flat list of\npage, x, y, width, height, kilde,\nyolo_conf, paddle_rec_score, trekk;
stop
@enduml
