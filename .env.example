# Copy to .env on the server. The file is the deploy state for this machine:
# it says which image runs where. deploy.sh writes PROD_TAG and TEST_TAG
# itself, so you normally do not edit those two.
#
# «ikke-satt» is a literal deploy.sh checks for — do not translate it.

# The tag running in prod on port 5071.
PROD_TAG=ikke-satt

# The tag running on the test port.
TEST_TAG=ikke-satt

# The port the test container is exposed on. Cannot be 5071.
TEST_PORT=5072

# Outgoing proxy for build and run.
PROXY=http://159.162.48.7:3128

# Logging is normally driven by server.env (SLADD_LOGS and SLADD_LOG_DAYS),
# which deploy.sh reads and passes on. The values below are only a fallback
# for machines without server.env — if server.env sets them, it wins.
LOG_ROOT=/data/docker
LOG_BACKUP_DAYS=30
