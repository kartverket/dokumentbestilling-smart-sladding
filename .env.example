# Kopier til .env på serveren. Filen er deploy-tilstanden for denne
# maskinen: den sier hvilket image som kjører hvor. deploy.sh skriver
# PROD_TAG og TEST_TAG selv — du trenger normalt ikke redigere dem.

# Taggen som kjører i prod på port 5071.
PROD_TAG=ikke-satt

# Taggen som kjører på testporten.
TEST_TAG=ikke-satt

# Porten testcontaineren eksponeres på. Kan ikke være 5071.
TEST_PORT=5072

# Utgående proxy for bygg og kjøring.
PROXY=http://159.162.48.7:3128

# Loggene styres normalt av server.env (SLADD_LOGS og SLADD_LOGG_DAGER),
# som deploy.sh leser og sender videre. Verdiene under er bare en
# fallback for maskiner uten server.env — er de satt i server.env,
# vinner den.
LOG_ROOT=/data/docker
LOG_BACKUP_DAYS=30

